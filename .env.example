# Copy to .env for local development. Generate real secrets with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Storefront address(es) allowed to call the API (comma-separated)
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=shopkart-db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# ---- Production only (Render) ----
# PUBLIC_URL=https://shopkart-server.onrender.com
# IS_PROXIED=true
# DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_SSL=true
# DATABASE_POOL_MIN=0
# DATABASE_POOL_MAX=5
# Cloudflare R2 (product images). Leave R2_BUCKET empty to keep files in public/uploads.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=shopkart-images
# R2_PUBLIC_URL=https://shopkart-server.onrender.com/images
